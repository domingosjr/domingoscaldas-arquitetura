# Copie para .env (nao versionado) para trocar as credenciais dos bancos e do RabbitMQ usadas pelo compose.yml.
# Sem este arquivo, o Compose usa os valores padrao de demonstracao.
PRINCIPAL_DB_USERNAME=bjj
PRINCIPAL_DB_PASSWORD=troque-esta-senha
PRINCIPAL_DB_ROOT_PASSWORD=troque-esta-senha-root
CAMPEONATO_DB_USERNAME=campeonato
CAMPEONATO_DB_PASSWORD=troque-esta-senha
CAMPEONATO_DB_ROOT_PASSWORD=troque-esta-senha-root
RABBITMQ_USERNAME=bjj
RABBITMQ_PASSWORD=troque-esta-senha
